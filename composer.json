{
  "name": "inventory/workspace",
  "description": "Inventory and order management system",
  "type": "project",
  "require": {"php": "^8.2", "ext-pdo": "*", "ext-pdo_mysql": "*"},
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1"},
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse", "check": ["@test", "@analyse"]}
}
